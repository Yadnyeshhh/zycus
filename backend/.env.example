# StockPulse Backend Environment Configuration (Optional)
# Copy this file to .env or set environment variables in your shell.

# AI / LLM Provider Configuration
# Supported providers: gemini | groq | ollama | openai | mock
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com

# For Groq + Llama 3.1:
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_your_groq_api_key
# LLM_MODEL=llama-3.1-8b-instant
# LLM_BASE_URL=https://api.groq.com

# For Ollama Local:
# LLM_PROVIDER=ollama
# LLM_API_KEY=
# LLM_MODEL=llama3.1
# LLM_BASE_URL=http://localhost:11434

# Server Configuration
PORT=8080
